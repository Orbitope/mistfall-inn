[gd_scene load_steps=3 format=3 uid="uid://bmistfallplay01"]

[ext_resource type="Script" path="res://scenes/play.gd" id="1_play"]

; One theme on the root so everything inherits a readable size, including the
; choice buttons the script creates at runtime. Setting sizes per-node would
; miss those entirely.
[sub_resource type="Theme" id="Theme_ui"]
default_font_size = 30

[node name="Play" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_ui")
script = ExtResource("1_play")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 28

[node name="Rows" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Top" type="HBoxContainer" parent="Margin/Rows"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 28

[node name="Portrait" type="TextureRect" parent="Margin/Rows/Top"]
texture_filter = 1
custom_minimum_size = Vector2(256, 256)
layout_mode = 2
size_flags_vertical = 0
expand_mode = 1
stretch_mode = 5

[node name="Text" type="RichTextLabel" parent="Margin/Rows/Top"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
bbcode_enabled = true
fit_content = true

[node name="Choices" type="VBoxContainer" parent="Margin/Rows"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Status" type="Label" parent="Margin/Rows"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "—"

[node name="Skills" type="Label" parent="Margin/Rows"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "—"
