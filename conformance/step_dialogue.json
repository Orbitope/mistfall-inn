[
  {
    "fn": "stepDialogue",
    "description": "base state (wit=0, has_key absent): showIf-gated choices hidden",
    "dialogue": {
      "id": "dlg_conformance",
      "entry": "node_start",
      "nodes": [
        {
          "id": "node_start",
          "text": "Start.",
          "onEnter": [
            {
              "type": "set_flag",
              "flag": "visited_start",
              "value": true
            }
          ],
          "choices": [
            {
              "id": "ch_goto",
              "text": "Proceed.",
              "goto": "node_end"
            },
            {
              "id": "ch_skill_req",
              "text": "Need wit≥5.",
              "goto": "node_end",
              "showIf": {
                "type": "skill",
                "skill": "wit",
                "op": ">=",
                "value": 5
              }
            },
            {
              "id": "ch_flag_req",
              "text": "Need key.",
              "goto": "node_end",
              "showIf": {
                "type": "flag",
                "flag": "has_key",
                "value": true
              }
            },
            {
              "id": "ch_check",
              "text": "Roll.",
              "check": {
                "mode": "active",
                "skill": "wit",
                "difficulty": 10,
                "onSuccess": "node_win",
                "onFailure": "node_lose"
              }
            },
            {
              "id": "ch_passive",
              "text": "Passive.",
              "goto": "node_win",
              "check": {
                "mode": "passive",
                "skill": "wit",
                "difficulty": 5
              }
            }
          ]
        },
        {
          "id": "node_end",
          "isEnd": true,
          "text": "End.",
          "choices": [
            {
              "id": "ch_terminal",
              "text": "Done."
            }
          ]
        },
        {
          "id": "node_win",
          "isEnd": true,
          "text": "Won."
        },
        {
          "id": "node_lose",
          "isEnd": true,
          "text": "Lost."
        }
      ]
    },
    "nodeId": "node_start",
    "state": {
      "flags": {},
      "reputation": {},
      "skills": {},
      "counters": {},
      "inventory": [],
      "questStages": {},
      "xp": 0,
      "skillPointsSpent": {}
    },
    "expected": {
      "visibleChoiceIds": [
        "ch_goto",
        "ch_check",
        "ch_passive"
      ],
      "onEnterEffectCount": 1
    }
  },
